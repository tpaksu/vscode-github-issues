{
  "name": "github-issue-viewer",
  "displayName": "GitHub Issue Viewer",
  "description": "View GitHub issue descriptions in VS Code",
  "version": "0.2.6",
  "publisher": "tpaksu",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tpaksu/vscode-github-issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": "^18.18.0 || >=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "github-issue-viewer.showIssue",
        "title": "Show GitHub Issue"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "authentication": [
    {
      "id": "github",
      "label": "GitHub Account",
      "scopes": [
        "repo",
        "read:user"
      ]
    }
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "lint": "eslint src",
    "package": "rm -rf ./github-issue*.vsix && vsce package",
    "build": "npm run compile && npm run package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.18.0",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.57.0",
    "sinon": "^21.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@octokit/openapi-types": "^24.2.0",
    "@octokit/rest": "^20.1.2",
    "@octokit/types": "^13.10.0",
    "javascript-time-ago": "^2.5.11"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
